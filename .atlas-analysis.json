  "keyFeatures": [
    "Living topic graph connecting code, decisions, and architectural knowledge",
    "Automatic drift detection — topics go stale when covered code changes",
    "GitHub App integration for PR-driven context nudges",
    "CLI for agents (Claude Code, Cursor, Codex) to pull and push context",
    "Architecture map with coverage overlay per repo",
    "AGENTS.md skill injection for AI coding agents",
    "Cross-repo context linking",
    "Full-text search across all workspace topics"
  ],
  "publicApiSurface": [
    "GET /api/v1/me",
    "GET /api/v1/workspaces/_/watchers",
    "GET /api/v1/workspaces/_/watchers/:slug",
