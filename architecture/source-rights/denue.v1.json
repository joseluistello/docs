  "fieldPolicy": {
    "allowedPublic": [
      {
        "sourceFields": ["nom_estab", "raz_social"],
        "purpose": "Display a named establishment observation, never a verified company or supplier identity.",
        "conditions": ["omit_empty_values", "pass_contact_like_text_scanner", "label_identity_as_approximate", "do_not_render_a_natural_person_name", "the_2025_dictionary_states_raz_social_is_omitted_for_natural_person_establishments"]
      },
      {
        "sourceFields": ["codigo_act", "nombre_act"],
        "purpose": "Explain the observed SCIAN 2023 classification and its limits.",
        "conditions": ["do_not_claim_certification_capability_or_current_capacity", "state_proxy_precision_when_applicable"]
      },
      {
        "sourceFields": ["per_ocu", "tipoUniEco"],
        "purpose": "Show publisher-defined establishment size band and establishment type.",
        "conditions": ["use_publisher_labels", "do_not_infer_revenue_or_capacity"]
      },
      {
        "sourceFields": ["cve_ent", "entidad", "cve_mun", "municipio", "cve_loc", "localidad"],
        "purpose": "Show state, municipality and locality geography validated against the official catalog.",
        "conditions": ["do_not_expand_to_exact_address", "validate_names_and_codes_against_marco_geoestadistico"]
      },
      {
        "sourceFields": ["fecha_alta"],
        "purpose": "State when the observation entered DENUE, not when the business started or was last verified.",
        "conditions": ["label_as_denue_incorporation_date"]
      }
    ],
    "internalOnly": [
      {
        "sourceFields": ["id", "CLEE"],
        "purpose": "Stable internal observation identity, deduplication and provenance binding.",
        "conditions": ["never_render_raw_identifier", "never_treat_as_verified_cross_source_company_identity"]
      }
    ],
    "forbiddenPublic": [
      {
        "sourceFields": ["telefono", "correoelec", "www"],
        "purpose": "Contact coordinates are excluded from every public SEO projection by Brein privacy policy.",
        "conditions": ["availability_boolean_or_aggregate_only", "no_raw_value_in_copy_metadata_jsonld_or_logs"]
      },
      {
        "sourceFields": ["tipo_vial", "nom_vial", "tipo_v_e_1", "nom_v_e_1", "tipo_v_e_2", "nom_v_e_2", "tipo_v_e_3", "nom_v_e_3", "numero_ext", "letra_ext", "edificio", "edificio_e", "numero_int", "letra_int", "tipo_asent", "nomb_asent", "tipoCenCom", "nom_CenCom", "num_local", "cod_postal", "ageb", "manzana", "latitud", "longitud"],
        "purpose": "Exact address, small-area and point-location data are unnecessary for public supplier SEO and increase contactability and privacy risk.",
