{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Brein",
  "description": "Brein es tu espacio comercial: conecta ChatGPT, Claude o Codex y trabaja con tu asistente para encontrar clientes y avanzar oportunidades.",
  "theme": "linden",
  "favicon": "/favicon.png",
  "logo": {
    "light": "/brand-mark.png",
    "dark": "/brand-mark.png",
    "href": "https://trybrein.com",
    "favicon": "/favicon.png"
  },
  "colors": {
    "primary": "#38632c",
    "light": "#5f9a4a",
    "dark": "#2c4f22"
  },
  "background": {
    "color": {
      "light": "#faf8f3",
      "dark": "#181712"
    }
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "fonts": {
    "heading": {
      "family": "Newsreader",
      "weight": 600
    },
    "body": {
      "family": "Hanken Grotesk",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": "github-light"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://trybrein.com/blog"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.trybrein.com"
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": false,
        "groups": [
          {
            "group": "Start",
            "icon": "rocket",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Connect",
            "icon": "plug",
            "pages": [
              "connect/chatgpt",
              "connect/claude",
              "connect/codex-cursor",
              "connect/openclaw",
              "connect/other-clients"
            ]
          },
          {
            "group": "Work with your agent",
            "icon": "handshake",
            "pages": [
              "work/first-requests",
              "work/who-does-what",
              "work/cerebro",
              "work/prospect",
              "work/pipeline",
              "work/sequence",
              "work/government",
              "work/forms",
              "work/review"
            ]
          },
          {
            "group": "Trust",
            "icon": "shield-check",
            "pages": [
              "trust/yes",
              "trust/credits",
              "trust/privacy"
            ]
          },
          {
            "group": "For developers",
            "icon": "code",
            "pages": [
              "mcp/overview",
              "mcp/permissions",
              "mcp/catalog",
              "mcp/errors",
              "api/forms"
            ]
          }
        ]
      },
      {
        "language": "es",
        "default": true,
        "groups": [
          {
            "group": "Inicio",
            "icon": "rocket",
            "pages": [
              "es/index"
            ]
          },
          {
            "group": "Conecta",
            "icon": "plug",
            "pages": [
