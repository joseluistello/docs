{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Driftless",
  "description": "Shared codebase memory for engineering teams and coding agents.",
  "theme": "linden",
  "favicon": "https://media.brand.dev/0113d1c7-09f1-4cd5-94a4-dda27d42796f.png",
  "logo": {
    "light": "/terminal-icon.png",
    "dark": "/terminal-icon.png",
    "href": "https://driftless.icu"
  },
  "colors": {
    "primary": "#b8e87a",
    "light": "#8aaf5b",
    "dark": "#0a0b0c"
  },
  "background": {
    "color": {
      "light": "#0a0b0c",
      "dark": "#0a0b0c"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "family": "Geist Mono"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": "github-dark"
    }
  },
  "navbar": {
    "links": [
      { "label": "GitHub", "href": "https://github.com/driftless-sh/driftless" }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://driftless.icu"
    }
  },
  "navigation": {
    "dropdowns": [
      {
        "dropdown": "Documentation",
        "icon": "book-open",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "dropdown": "Concepts",
        "icon": "brain",
        "pages": [
          "concepts/core-loop",
          "concepts/topics",
          "concepts/drift",
          "concepts/coverage"
        ]
      },
      {
        "dropdown": "CLI & Agents",
        "icon": "terminal",
        "pages": [
          "cli/setup",
          "cli/context",
          "cli/graph",
          "cli/sync",
          "agents/setup"
        ]
      },
      {
        "dropdown": "API",
        "icon": "braces",
        "pages": [
          "api/overview",
          "api/workspaces",
          "api/repos",
          "api/topics",
          "api/integrations"
        ]
      },
      {
        "dropdown": "Integrations",
        "icon": "plug",
        "pages": [
          "integrations/github-app"
        ]
      },
      {
        "dropdown": "Security",
        "icon": "shield",
        "pages": [
          "security/overview"
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/driftless-sh/driftless",
      "x": "https://x.com/driftless_sh"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Dashboard", "href": "https://driftless.icu" },
          { "label": "Blog", "href": "https://driftless.icu/blog" },
          { "label": "GitHub App", "href": "/integrations/github-app" }
        ]
      },
      {
        "header": "Reference",
        "items": [
          { "label": "CLI Reference", "href": "/cli/setup" },
          { "label": "API Reference", "href": "/api/overview" },
          { "label": "Agent Setup", "href": "/agents/setup" }
        ]
      },
      {
        "header": "Company",
        "items": [
          { "label": "GitHub", "href": "https://github.com/driftless-sh/driftless" },
          { "label": "Security", "href": "/security/overview" }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/cli/reference",
      "destination": "/cli/setup"
    },
    {
      "source": "/cli/installation",
      "destination": "/cli/setup"
    },
    {
      "source": "/api/reference",
      "destination": "/api/overview"
    },
    {
      "source": "/changelog",
      "destination": "/changelog/index"
    }
  ]
}
