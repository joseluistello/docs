{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Brein",
  "description": "One workspace where a team and its agents share what they know, what they operate, and the work in flight, in one governed system.",
  "theme": "linden",
  "favicon": "/favicon.png",
  "logo": {
    "light": "/brand-mark.png",
    "dark": "/brand-mark.png",
    "href": "https://trybrein.com",
    "favicon": "/favicon.png"
  },
  "colors": {
    "primary": "#38632c",
    "light": "#5f9a4a",
    "dark": "#2c4f22"
  },
  "background": {
    "color": {
      "light": "#faf8f3",
      "dark": "#181712"
    }
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "fonts": {
    "heading": {
      "family": "Newsreader",
      "weight": 600
    },
    "body": {
      "family": "Hanken Grotesk",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
