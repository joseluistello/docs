{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Driftless",
  "description": "Shared codebase memory for engineering teams and coding agents.",
  "theme": "aspen",
  "favicon": "https://media.brand.dev/0113d1c7-09f1-4cd5-94a4-dda27d42796f.png",
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo.svg",
    "href": "https://driftless.icu"
  },
  "colors": {
    "primary": "#b8e87a",
    "light": "#8aaf5b",
    "dark": "#0a0b0c"
  },
  "background": {
    "color": {
      "light": "#0a0b0c",
      "dark": "#0a0b0c"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "family": "Geist Mono"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": "github-dark"
    }
  },
  "navbar": {
    "links": [
      { "label": "Dashboard", "href": "https://driftless.icu" },
      { "label": "GitHub", "href": "https://github.com/driftless-sh/driftless" }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://driftless.icu"
    }
  },
  "navigation": {
    "anchors": [
      {
        "anchor": "Documentation",
        "icon": "book-open",
        "tabs": [
          {
            "tab": "Home",
            "icon": "home",
            "groups": [
              {
                "group": "Get Started",
                "icon": "rocket",
                "pages": ["index", "quickstart"]
              }
            ]
          },
          {
            "tab": "Concepts",
            "icon": "brain",
            "groups": [
              {
                "group": "The Loop",
                "icon": "repeat",
                "pages": ["concepts/core-loop"]
              },
              {
                "group": "Knowledge Layer",
                "icon": "network",
                "pages": ["concepts/topics", "concepts/drift", "concepts/coverage"]
              }
            ]
          },
          {
            "tab": "CLI & Agents",
            "icon": "terminal",
            "groups": [
              {
                "group": "Setup",
                "icon": "download",
                "pages": ["cli/installation"]
              },
              {
                "group": "CLI",
                "icon": "terminal",
                "pages": ["cli/reference"]
              },
              {
                "group": "Agents",
                "icon": "bot",
                "pages": ["agents/setup"]
              }
            ]
          },
          {
            "tab": "API",
            "icon": "braces",
            "groups": [
              {
                "group": "REST API",
                "icon": "server",
                "pages": ["api/reference"]
              }
            ]
          },
          {
            "tab": "Integrations",
            "icon": "plug",
            "groups": [
              {
                "group": "GitHub App",
                "icon": "github",
                "pages": ["integrations/github-app"]
              }
            ]
          },
          {
            "tab": "Security",
            "icon": "shield",
            "groups": [
              {
                "group": "Overview",
                "icon": "lock",
                "pages": ["security/overview"]
              }
            ]
          },
          {
            "tab": "Changelog",
            "icon": "clock",
            "groups": [
              {
                "group": "Release Notes",
                "icon": "sparkles",
                "pages": ["changelog/index"]
              }
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/driftless-sh/driftless",
      "x": "https://x.com/driftless_sh"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Dashboard", "href": "https://driftless.icu" },
          { "label": "Blog", "href": "https://driftless.icu/blog" },
          { "label": "GitHub App", "href": "/integrations/github-app" }
        ]
      },
      {
        "header": "Reference",
        "items": [
          { "label": "CLI Reference", "href": "/cli/reference" },
          { "label": "API Reference", "href": "/api/reference" },
          { "label": "Agent Setup", "href": "/agents/setup" }
        ]
      },
      {
        "header": "Company",
        "items": [
          { "label": "GitHub", "href": "https://github.com/driftless-sh/driftless" },
          { "label": "Security", "href": "/security/overview" }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/quickstart"
    }
  ]
}
