{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Driftless",
  "description": "Shared context layer for engineering teams and coding agents.",
  "theme": "linden",
  "favicon": "/favicon.png",
  "logo": {
    "light": "/brand-icon.svg",
    "dark": "/brand-icon.svg",
    "href": "https://driftless.icu",
    "favicon": "/favicon.png"
  },
  "colors": {
    "primary": "#38632c",
    "light": "#5f9a4a",
    "dark": "#2c4f22"
  },
  "background": {
    "color": {
      "light": "#faf8f3",
      "dark": "#181712"
    }
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "Hanken Grotesk",
      "weight": 600
    },
    "body": {
      "family": "Hanken Grotesk",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": "github-light"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://driftless.icu/blog"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://driftless.icu"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "icon": "rocket",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Concepts",
        "icon": "brain",
        "pages": [
          "concepts/topics",
          "concepts/core-loop",
          "concepts/governance",
          "concepts/projects",
          "concepts/drift",
          "concepts/pr-bot",
          "concepts/automations"
        ]
      },
      {
        "group": "CLI & agents",
        "icon": "terminal",
        "pages": [
          "cli/setup",
          "cli/context",
          "cli/sync",
          "agents/setup",
          "agents/agentic-layer"
        ]
      },
      {
        "group": "API",
        "icon": "code",
        "pages": [
          "api/overview",
          "api/errors",
          "api/workspaces",
          "api/repos",
          "api/topics",
          "api/projects",
          "api/integrations",
          "integrations/github-app"
        ]
      },
      {
        "group": "Platform",
        "icon": "shield-check",
        "pages": [
          "mcp/overview",
          "security/overview"
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/driftless-sh/driftless"
    },
    "links": [
      {
        "header": "Driftless",
        "items": [
          {
            "label": "Dashboard",
            "href": "https://driftless.icu"
          },
          {
            "label": "Blog",
            "href": "https://driftless.icu/blog"
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/cli/reference",
      "destination": "/cli/setup"
    },
    {
      "source": "/cli/installation",
      "destination": "/cli/setup"
    },
    {
      "source": "/api/reference",
      "destination": "/api/overview"
    },
    {
      "source": "/cli/graph",
      "destination": "/cli/context"
    },
    {
      "source": "/concepts/coverage",
      "destination": "/concepts/pr-bot"
    },
    {
      "source": "/dashboard/overview",
      "destination": "/concepts/core-loop"
    }
  ],
  "seo": {
    "metatags": {
      "og:image": "https://driftless.icu/opengraph.jpg",
      "og:image:width": "1200",
      "og:image:height": "630",
      "twitter:image": "https://driftless.icu/opengraph.jpg",
      "twitter:card": "summary_large_image"
    },
    "indexing": "all"
  }
}
