{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Driftless",
  "description": "Shared context layer for engineering teams and coding agents.",
  "theme": "linden",
  "favicon": "https://media.brand.dev/0113d1c7-09f1-4cd5-94a4-dda27d42796f.png",
  "logo": {
    "light": "/terminal-icon.png",
    "dark": "/terminal-icon.png",
    "href": "https://driftless.icu"
  },
  "colors": {
    "primary": "#b8e87a",
    "light": "#8aaf5b",
    "dark": "#0a0b0c"
  },
  "background": {
    "color": {
      "light": "#0a0b0c",
      "dark": "#0a0b0c"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "family": "Geist Mono",
    "weight": 400
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": "github-dark"
    }
  },
  "navbar": {
    "links": [
      { "label": "Blog", "href": "https://driftless.icu/blog" }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://driftless.icu"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Start",
        "groups": [
          {
            "group": "Start here",
            "icon": "rocket",
            "pages": ["index", "quickstart"]
          }
        ]
      },
      {
        "tab": "Concepts",
        "groups": [
          {
            "group": "Repo memory",
            "icon": "brain",
            "pages": ["concepts/topics", "concepts/core-loop"]
          },
          {
            "group": "Context integrity",
            "icon": "radar",
            "pages": ["concepts/drift", "concepts/pr-bot"]
          }
        ]
      },
      {
        "tab": "CLI",
        "groups": [
          {
            "group": "Setup",
            "icon": "wrench",
            "pages": ["cli/setup"]
          },
          {
            "group": "Daily workflow",
            "icon": "refresh-cw",
            "pages": ["cli/sync", "cli/context"]
          },
          {
            "group": "Agents",
            "icon": "bot",
            "pages": ["agents/setup"]
          }
        ]
      },
      {
        "tab": "API",
        "groups": [
          {
            "group": "Overview",
            "icon": "book-open",
            "pages": ["api/overview"]
          },
          {
            "group": "Core resources",
            "icon": "database",
            "pages": ["api/workspaces", "api/repos", "api/topics"]
          },
          {
            "group": "Integrations",
            "icon": "plug",
            "pages": ["api/integrations", "integrations/github-app"]
          }
        ]
      },
      {
        "tab": "Security",
        "groups": [
          {
            "group": "Security",
            "icon": "shield-check",
            "pages": ["security/overview"]
          }
        ]
      },
      {
        "tab": "MCP",
        "groups": [
          {
            "group": "MCP & OAuth",
            "icon": "plug",
            "pages": ["mcp/overview"]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/driftless-sh/driftless"
    },
    "links": [
      {
        "header": "Driftless",
        "items": [
          { "label": "Dashboard", "href": "https://driftless.icu" },
          { "label": "Blog", "href": "https://driftless.icu/blog" }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/cli/reference",
      "destination": "/cli/setup"
    },
    {
      "source": "/cli/installation",
      "destination": "/cli/setup"
    },
    {
      "source": "/api/reference",
      "destination": "/api/overview"
    },
    {
      "source": "/cli/graph",
      "destination": "/cli/context"
    },
    {
      "source": "/concepts/coverage",
      "destination": "/concepts/pr-bot"
    },
    {
      "source": "/dashboard/overview",
      "destination": "/concepts/core-loop"
    }
  ]
}