{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Brein",
  "description": "A commercial-intelligence workspace for founders and sales teams: find a market, understand the evidence, and move a real opportunity forward.",
  "theme": "linden",
  "favicon": "/favicon.png",
  "logo": {
    "light": "/brand-mark.png",
    "dark": "/brand-mark.png",
    "href": "https://trybrein.com",
    "favicon": "/favicon.png"
  },
  "colors": {
    "primary": "#38632c",
    "light": "#5f9a4a",
    "dark": "#2c4f22"
  },
  "background": {
    "color": {
      "light": "#faf8f3",
      "dark": "#181712"
    }
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "fonts": {
    "heading": {
      "family": "Newsreader",
      "weight": 600
    },
    "body": {
      "family": "Hanken Grotesk",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": "github-light"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://trybrein.com/blog"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.trybrein.com"
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart",
              "product/workspace"
            ]
          },
          {
            "group": "Work in Brein",
            "icon": "layers",
            "pages": [
              "guides/overview",
              "guides/commercial-onboarding"
            ]
          },
          {
            "group": "Connect your AI",
            "icon": "sparkles",
            "pages": [
              "connect",
              "integrations/self-hosted-agents"
            ]
          },
          {
            "group": "For developers",
            "icon": "code",
            "pages": [
              "mcp/overview",
              "api/overview",
              "api/errors",
              "security/overview"
            ]
          },
          {
            "group": "MCP reference",
            "icon": "boxes",
            "pages": [
              "mcp/catalog",
              "mcp/knowledge",
              "mcp/work",
              "mcp/sequences",
              "mcp/integrations",
              "mcp/collaboration"
            ]
          }
        ]
      },
      {
        "language": "es",
        "groups": [
          {
            "group": "Primeros pasos",
            "icon": "rocket",
            "pages": [
              "es/index",
              "es/quickstart",
              "es/product/workspace"
            ]
          },
          {
            "group": "Trabaja en Brein",
            "icon": "layers",
            "pages": [
              "es/guides/overview",
              "es/guides/commercial-onboarding"
            ]
          },
          {
            "group": "Conecta tu IA",
            "icon": "sparkles",
            "pages": [
              "es/connect",
              "es/integrations/self-hosted-agents"
            ]
          },
          {
            "group": "Para desarrolladores",
            "icon": "code",
            "pages": [
              "es/mcp/overview",
              "es/api/overview",
              "es/api/errors",
              "es/security/overview"
            ]
          },
          {
            "group": "Referencia MCP",
            "icon": "boxes",
            "pages": [
              "es/mcp/catalog",
              "es/mcp/knowledge",
              "es/mcp/work",
              "es/mcp/sequences",
              "es/mcp/integrations",
              "es/mcp/collaboration"
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/driftless-sh/driftless"
    },
    "links": [
      {
        "header": "Brein",
        "items": [
          {
            "label": "Dashboard",
            "href": "https://app.trybrein.com"
          },
          {
            "label": "Blog",
            "href": "https://trybrein.com/blog"
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/api/reference",
      "destination": "/api/overview"
    },
    {
      "source": "/dashboard/overview",
      "destination": "/product/workspace"
    },
    {
      "source": "/agents/agentic-layer",
      "destination": "/product/workspace"
    },
    {
      "source": "/concepts/comments",
      "destination": "/product/workspace"
    },
    {
      "source": "/guides/operate-a-collection",
      "destination": "/guides/overview"
    },
    {
      "source": "/guides/govern-agent-learning",
      "destination": "/guides/overview"
    },
    {
      "source": "/guides/clean-workspace-context",
      "destination": "/guides/overview"
    },
    {
      "source": "/guides/external-context-with-broker",
      "destination": "/mcp/integrations"
    },
    {
      "source": "/api/collaboration",
      "destination": "/mcp/collaboration"
    },
    {
      "source": "/es/dashboard/overview",
      "destination": "/es/product/workspace"
    },
    {
      "source": "/es/agents/agentic-layer",
      "destination": "/es/product/workspace"
    },
    {
      "source": "/es/concepts/comments",
      "destination": "/es/product/workspace"
    },
    {
      "source": "/es/guides/operate-a-collection",
      "destination": "/es/guides/overview"
    },
    {
      "source": "/es/guides/govern-agent-learning",
      "destination": "/es/guides/overview"
    },
    {
      "source": "/es/guides/clean-workspace-context",
      "destination": "/es/guides/overview"
    },
    {
      "source": "/es/guides/external-context-with-broker",
      "destination": "/es/mcp/integrations"
    },
    {
      "source": "/es/api/collaboration",
      "destination": "/es/mcp/collaboration"
    }
  ],
  "seo": {
    "metatags": {
      "canonical": "https://docs.trybrein.com",
      "og:image": "https://trybrein.com/opengraph.png",
      "og:image:width": "1200",
      "og:image:height": "630",
      "twitter:image": "https://trybrein.com/opengraph.png",
      "twitter:card": "summary_large_image"
    },
    "indexing": "all"
  }
}
