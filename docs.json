{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Driftless",
  "description": "Shared codebase memory for engineering teams and coding agents.",
  "theme": "linden",
  "favicon": "https://media.brand.dev/0113d1c7-09f1-4cd5-94a4-dda27d42796f.png",
  "logo": {
    "light": "/terminal-icon.png",
    "dark": "/terminal-icon.png",
    "href": "https://driftless.icu"
  },
  "colors": {
    "primary": "#b8e87a",
    "light": "#8aaf5b",
    "dark": "#0a0b0c"
  },
  "background": {
    "color": {
      "light": "#0a0b0c",
      "dark": "#0a0b0c"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "family": "Geist Mono"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": "github-dark"
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://driftless.icu"
    }
  },
  "navigation": {
    "anchors": [
      {
        "anchor": "Documentation",
        "icon": "book-open",
        "tabs": [
          {
            "tab": "Home",
            "icon": "home",
            "groups": [
              {
                "group": "Introduction",
                "icon": "book-open",
                "pages": ["index"]
              },
              {
                "group": "Quickstart",
                "icon": "rocket",
                "pages": ["quickstart"]
              }
            ]
          },
          {
            "tab": "Concepts",
            "icon": "brain",
            "groups": [
              {
                "group": "The Driftless Loop",
                "icon": "repeat",
                "pages": ["concepts/core-loop"]
              },
              {
                "group": "Topics & Knowledge Graph",
                "icon": "network",
                "pages": ["concepts/topics"]
              },
              {
                "group": "Drift Detection",
                "icon": "radar",
                "pages": ["concepts/drift"]
              },
              {
                "group": "Context Coverage",
                "icon": "scan-search",
                "pages": ["concepts/coverage"]
              }
            ]
          },
          {
            "tab": "CLI & Agents",
            "icon": "terminal",
            "groups": [
              {
                "group": "CLI Setup",
                "icon": "download",
                "pages": ["cli/setup"]
              },
              {
                "group": "Context Commands",
                "icon": "notebook-tabs",
                "pages": ["cli/context"]
              },
              {
                "group": "Graph & Impact",
                "icon": "git-graph",
                "pages": ["cli/graph"]
              },
              {
                "group": "Sync & Branches",
                "icon": "refresh-cw",
                "pages": ["cli/sync"]
              },
              {
                "group": "Agent Setup",
                "icon": "bot",
                "pages": ["agents/setup"]
              }
            ]
          },
          {
            "tab": "API",
            "icon": "braces",
            "groups": [
              {
                "group": "Overview",
                "icon": "book-marked",
                "pages": ["api/overview"]
              },
              {
                "group": "Workspaces",
                "icon": "building",
                "pages": ["api/workspaces"]
              },
              {
                "group": "Repositories & Scans",
                "icon": "folder-git",
                "pages": ["api/repos"]
              },
              {
                "group": "Topics",
                "icon": "notebook-tabs",
                "pages": ["api/topics"]
              },
              {
                "group": "Integrations & PR Activity",
                "icon": "plug",
                "pages": ["api/integrations"]
              }
            ]
          },
          {
            "tab": "Integrations",
            "icon": "plug",
            "groups": [
              {
                "group": "GitHub App",
                "icon": "github",
                "pages": ["integrations/github-app"]
              }
            ]
          },
          {
            "tab": "Security",
            "icon": "shield",
            "groups": [
              {
                "group": "Overview",
                "icon": "lock",
                "pages": ["security/overview"]
              }
            ]
          },
          {
            "tab": "Release Notes",
            "icon": "sparkles",
            "groups": [
              {
                "group": "Changelog",
                "icon": "clock",
                "pages": ["changelog/index"]
              }
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/driftless-sh/driftless",
      "x": "https://x.com/driftless_sh"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Dashboard", "href": "https://driftless.icu" },
          { "label": "Blog", "href": "https://driftless.icu/blog" },
          { "label": "GitHub App", "href": "/integrations/github-app" }
        ]
      },
      {
        "header": "Reference",
        "items": [
          { "label": "CLI Reference", "href": "/cli/setup" },
          { "label": "API Reference", "href": "/api/overview" },
          { "label": "Agent Setup", "href": "/agents/setup" }
        ]
      },
      {
        "header": "Company",
        "items": [
          { "label": "GitHub", "href": "https://github.com/driftless-sh/driftless" },
          { "label": "Security", "href": "/security/overview" }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/cli/reference",
      "destination": "/cli/setup"
    },
    {
      "source": "/cli/installation",
      "destination": "/cli/setup"
    },
    {
      "source": "/api/reference",
      "destination": "/api/overview"
    },
    {
      "source": "/changelog",
      "destination": "/changelog/index"
    }
  ]
}
